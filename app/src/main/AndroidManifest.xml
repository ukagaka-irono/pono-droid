<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- \![set,wallpaper]（アプリの設定で許したときだけ使う） -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 今日の予定をゴーストに伝える（アプリの設定で選び、許可したときだけ） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 声を聞いて、名前を呼ばれたらゴーストに伝える（アプリの設定で選び、許可したときだけ） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- ネットワークの切り替わりをゴーストに伝える（OnNetworkStatusChange） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ネットワーク更新の homeurl はいまも http:// のゴーストが多いので、平文の通信も許す -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 「共有」の受け口。.nar はインストールし、それ以外のファイルは起動中のゴーストに渡す（OnFileDrop2）。
             アプリの画面とは別のタスクにして、閉じたときに pono-droid の一覧が前に出てこないようにする -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- SSP の Web 関連付け（x-ukagaka-link:type=event&ghost=...&info=...） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="x-ukagaka-link" />
            </intent-filter>
        </activity>
        <!-- ゴーストのフォルダのファイルを、ほかのアプリで開くとき（渡したファイルを画像や音のアプリで開くなど）だけ、その1つを見せる -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ホーム画面のショートカット（\![create,shortcut]）から、そのゴーストを起こす。画面は出さない -->
        <activity
            android:name=".GhostShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 開発用の画面（\![open,backlogviewer / errorlog / surfacetest / developer / shiorirequest]） -->
        <activity
            android:name=".DeveloperActivity"
            android:exported="false" />

        <!-- \![open,dialog,open / save / folder / color]。選ぶ画面は Android のもので、色だけこの画面で選ぶ -->
        <activity
            android:name=".SystemDialogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- readme などを読む画面（\![open,readme]） -->
        <activity
            android:name=".TextViewerActivity"
            android:exported="false" />

        <service
            android:name=".overlay.GhostOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Desktop mascot (ukagaka ghost) shown over other apps" />
        </service>

        <!-- 通知へのアクセスを許してもらうためだけのもの。許されると、再生中の曲や動画をゴーストに伝えられる（通知そのものは読まない） -->
        <service
            android:name=".overlay.MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

    <!-- 再生中の曲や動画のアプリの名前と、ブラウザ（ブラウザで鳴っているものは動画とする）を見分けるため -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
